# Copy to .env and fill in. Never commit .env.
# Database (in Docker Compose the host is "db"; the password must match deploy/secrets/db_password.txt)
DATABASE_URL=postgres://lease:CHANGE_ME@db:5432/leasedb
# 32 random bytes, base64. Encrypts MFA secrets. Keep a copy in your password vault:
# losing it means every user must re-enrol MFA. Generate: openssl rand -base64 32
MASTER_KEY=
ORG_NAME=Allied Marketing
# Security policy
# Two-step sign-in (authenticator code) for everyone. Keep true in production; false = password only (keys already set up are kept)
REQUIRE_MFA=true
PASSWORD_MIN_LENGTH=12
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15
SESSION_HOURS=10
SESSION_IDLE_MINUTES=30
COOKIE_SECURE=true
LOG_LEVEL=info
# AI (optional). Without a key the AI features say they are not available. Monthly allowances in US$: each
# company may spend up to AI_MONTHLY_LIMIT_USD, and all companies together up to AI_TOTAL_MONTHLY_LIMIT_USD.
# Routine work uses AI_MODEL_DEFAULT, the advisor and narratives AI_MODEL_COMPLEX.
ANTHROPIC_API_KEY=
AI_MONTHLY_LIMIT_USD=5
AI_TOTAL_MONTHLY_LIMIT_USD=5
# AI_MODEL_DEFAULT=claude-haiku-5-5
# AI_MODEL_COMPLEX=claude-sonnet-5-5
