# Copy to .env.local (git-ignored) to change these for your machine.
# Use the backend API (../backend). Switched on module by module as the integration lands;
# until then the app keeps its data in this browser.
VITE_USE_API=false
# Where `npm run dev` / `npm run preview` forward /api requests.
VITE_API_TARGET=http://127.0.0.1:8090
