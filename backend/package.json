{
  "name": "ifrs16-lease-manager",
  "version": "0.1.0",
  "description": "IFRS 16 lease management: on-premises server",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "cli": "node src/cli.js",
    "audit:verify": "node src/cli.js verify-audit",
    "db:dev": "node scripts/dev-db.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "test:local": "node --env-file=.env --test --test-concurrency=1 tests/*.test.js",
    "cli:local": "node --env-file=.env src/cli.js"
  },
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fastify/cookie": "^9.4.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/static": "^7.0.4",
    "fastify": "^4.28.1",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "embedded-postgres": "16.14.0-beta.17"
  },
  "allowScripts": {
    "@embedded-postgres/darwin-x64@16.14.0-beta.17": true
  }
}
